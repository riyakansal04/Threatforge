  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ThreatForge Remediation Engineer",
          "rules": [
            {
              "id": "BF-STD-001",
              "name": "Client-controlled cookie is deserialized with pickle"
            },
            {
              "id": "BF-STD-002",
              "name": "DNS lookup route concatenates form input into an OS command"
            },
            {
              "id": "BF-STD-003",
              "name": "Expression evaluation route executes user input with eval"
            },
            {
              "id": "BF-STD-004",
              "name": "XML parser enables DTD loading and network access"
            },
            {
              "id": "BF-STD-005",
              "name": "Config endpoint decrypts attacker-controlled ciphertext and returns padding errors"
            },
            {
              "id": "BF-STD-006",
              "name": "Greeting route renders user input as Jinja template source"
            },
            {
              "id": "BF-STD-007",
              "name": "Category query parameter is concatenated into SQL"
            },
            {
              "id": "BF-STD-008",
              "name": "JWT verifier accepts None and HS256 algorithms based on untrusted token header"
            }
          ]
        }
      },
