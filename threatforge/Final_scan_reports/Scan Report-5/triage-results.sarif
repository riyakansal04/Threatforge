{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ThreatForge Finding Triage",
          "informationUri": "local://Scan%20Report-5/TriageReport.md",
          "rules": [
            {"id": "python-eval-expression-injection", "name": "Python eval on request input", "shortDescription": {"text": "Request-controlled expression reaches eval."}, "properties": {"security-severity": "8.8", "tags": ["CWE-94"]}},
            {"id": "os-command-injection-lookup", "name": "OS command injection", "shortDescription": {"text": "Request-controlled address reaches os.popen."}, "properties": {"security-severity": "8.8", "tags": ["CWE-78"]}},
            {"id": "python-pickle-cookie-deserialization", "name": "Pickle cookie deserialization", "shortDescription": {"text": "Client-controlled cookie reaches pickle.loads."}, "properties": {"security-severity": "8.8", "tags": ["CWE-502"]}},
            {"id": "jinja-template-injection-sayhi", "name": "Jinja template injection", "shortDescription": {"text": "Request-controlled name becomes Jinja template source."}, "properties": {"security-severity": "8.2", "tags": ["CWE-1336"]}},
            {"id": "jwt-none-hs256-algorithm-confusion", "name": "JWT algorithm confusion", "shortDescription": {"text": "JWT verifier accepts None and HS256 based on token header."}, "properties": {"security-severity": "8.0", "tags": ["CWE-287", "CWE-347"]}},
            {"id": "sql-injection-listservices-category", "name": "SQL injection", "shortDescription": {"text": "Category query parameter reaches SQL string construction."}, "properties": {"security-severity": "7.8", "tags": ["CWE-89"]}},
            {"id": "xxe-enabled-xml-parser", "name": "XXE-enabled XML parser", "shortDescription": {"text": "Untrusted XML is parsed with DTD loading and network access enabled."}, "properties": {"security-severity": "6.5", "tags": ["CWE-611"]}},
            {"id": "cbc-padding-oracle-config", "name": "CBC padding oracle pattern", "shortDescription": {"text": "Chosen ciphertext reaches CBC decrypt and padding errors are returned."}, "properties": {"security-severity": "6.5", "tags": ["CWE-209", "CWE-327"]}}
          ]
        }
      },
      "automationDetails": {
        "id": "finding-triage-2026-10-05-scan-report-5"
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {"text": "Static triage only. No runtime validation and no source modification were performed."}
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "python-eval-expression-injection",
          "level": "error",
          "message": {"text": "BF-STD-003 confirmed: request.form['expression'] reaches eval(expression). No duplicate; related to BF-STD-002 and BF-STD-006."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 379}}}],
          "properties": {"findingId": "BF-STD-003", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 1, "duplicateOf": null, "relatedFindings": ["BF-STD-002", "BF-STD-006"], "validationMode": "static source review"}
        },
        {
          "ruleId": "os-command-injection-lookup",
          "level": "error",
          "message": {"text": "BF-STD-002 confirmed: request.form['address'] is concatenated into an nslookup command passed to os.popen. No duplicate; related to BF-STD-003 and BF-STD-006."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 172}}}, {"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 357}}}],
          "properties": {"findingId": "BF-STD-002", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 2, "duplicateOf": null, "relatedFindings": ["BF-STD-003", "BF-STD-006"], "validationMode": "static source review"}
        },
        {
          "ruleId": "python-pickle-cookie-deserialization",
          "level": "error",
          "message": {"text": "BF-STD-001 confirmed: browser-controlled value cookie is base64-decoded and passed to pickle.loads. No duplicate; related to BF-STD-008."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 329}}}],
          "properties": {"findingId": "BF-STD-001", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 3, "duplicateOf": null, "relatedFindings": ["BF-STD-008"], "validationMode": "static source review"}
        },
        {
          "ruleId": "jinja-template-injection-sayhi",
          "level": "error",
          "message": {"text": "BF-STD-006 confirmed: request.form['name'] is inserted into template source before render_template_string. No duplicate; related to BF-STD-003 and BF-STD-002."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 468}}}],
          "properties": {"findingId": "BF-STD-006", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 4, "duplicateOf": null, "relatedFindings": ["BF-STD-003", "BF-STD-002"], "validationMode": "static source review"}
        },
        {
          "ruleId": "jwt-none-hs256-algorithm-confusion",
          "level": "error",
          "message": {"text": "BF-STD-008 confirmed: verifier accepts None and HS256 based on untrusted JWT header and /user trusts the resulting sub claim. No duplicate; related to BF-STD-001 and BF-STD-005."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 32}}}, {"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 267}}}],
          "properties": {"findingId": "BF-STD-008", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 5, "duplicateOf": null, "relatedFindings": ["BF-STD-001", "BF-STD-005"], "validationMode": "static source review"}
        },
        {
          "ruleId": "sql-injection-listservices-category",
          "level": "error",
          "message": {"text": "BF-STD-007 confirmed: category query parameter is formatted into SQL and executed. No duplicate; impact is database-backend dependent."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 476}}}],
          "properties": {"findingId": "BF-STD-007", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 6, "duplicateOf": null, "relatedFindings": [], "validationMode": "static source review"}
        },
        {
          "ruleId": "xxe-enabled-xml-parser",
          "level": "warning",
          "message": {"text": "BF-STD-004 confirmed as unsafe parser configuration: untrusted XML is parsed with load_dtd=True and no_network=False. No duplicate; related to BF-STD-005."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 397}}}],
          "properties": {"findingId": "BF-STD-004", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 7, "duplicateOf": null, "relatedFindings": ["BF-STD-005"], "validationMode": "static source review"}
        },
        {
          "ruleId": "cbc-padding-oracle-config",
          "level": "warning",
          "message": {"text": "BF-STD-005 confirmed as a CBC padding-oracle pattern: chosen key ciphertext is decrypted and exception text is returned. No duplicate; related to BF-STD-004 and BF-STD-008."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 140}}}, {"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 428}}}],
          "properties": {"findingId": "BF-STD-005", "triageTechnicalVerdict": "confirmed", "exploitabilityStackRank": 8, "duplicateOf": null, "relatedFindings": ["BF-STD-004", "BF-STD-008"], "validationMode": "static source review"}
        }
      ]
    }
  ]
}
