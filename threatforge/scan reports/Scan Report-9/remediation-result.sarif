      "results": [
        {"ruleId": "TF-001", "level": "none", "message": {"text": "Fixed: eval replaced with constrained AST arithmetic evaluator."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 361}}}]},
