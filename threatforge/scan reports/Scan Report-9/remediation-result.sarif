        {"ruleId": "TF-003", "level": "none", "message": {"text": "Fixed: pickle cookie state replaced with HMAC-signed JSON."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 306}}}]},
        {"ruleId": "TF-004", "level": "none", "message": {"text": "Fixed: name is passed as Jinja variable into fixed template."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 434}}}]},
        {"ruleId": "TF-006", "level": "none", "message": {"text": "Fixed: JWT verification pinned to RS256; HS256/None dispatch removed."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 266}}}]},
        {"ruleId": "TF-005", "level": "none", "message": {"text": "Fixed: category filter is parameterized."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 476}}}]},
        {"ruleId": "TF-007", "level": "none", "message": {"text": "Fixed: XML parser disables DTD loading, network access, entity resolution, and huge_tree."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 388}}}]},
        {"ruleId": "TF-009", "level": "none", "message": {"text": "Fixed: affected outputs are escaped and raw exception reflection reduced."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 315}}}]},
        {"ruleId": "TF-010", "level": "none", "message": {"text": "Fixed: generated fallback JWT keys remain in memory and private paths are not printed."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 109}}}]},
        {"ruleId": "TF-008", "level": "none", "message": {"text": "Fixed: config selector uses signed token and generic invalid-token error."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.py"}, "region": {"startLine": 418}}}]},
